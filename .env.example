# URL de conexão com o banco de dados PostgreSQL (Ex: Neon.tech, Supabase ou local)
# Exemplo Neon / Supabase: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://seu_usuario:sua_senha@ep-exemplo.us-east-2.aws.neon.tech/pinttech?sslmode=require"

# Chave secreta usada para assinar e validar tokens JWT
JWT_SECRET="gere-uma-chave-secreta-forte-aqui-exemplo-abc123xyz"

# Configurações do NextAuth / Sessão
NEXTAUTH_SECRET="outra-chave-secreta-forte-aqui"
NEXTAUTH_URL="https://seu-projeto.vercel.app"
